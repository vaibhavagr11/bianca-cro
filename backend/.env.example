# Copy to backend/.env and fill in. Never commit .env.
ENV=dev
# Supabase -> Connect -> Connection String -> Method: Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.<project-id>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Shared secret n8n sends as X-Ingest-Token. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=
# Claude, for the email classifier (claude-opus-5-5 by default; claude-haiku-5-5 is the low-cost option)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Only if the key isn't scoped to a workspace: Console -> Settings -> Workspaces -> workspace ID
ANTHROPIC_WORKSPACE_ID=

# Read-only Bianca Sales connector. See docs/bianca-sales-connector.md for setup.
SALES_MCP_ENABLED=false
# SALES_MCP_URL=https://<backend-host>/sales/mcp
# SALES_MCP_ISSUER=https://<issuer-host>
# SALES_MCP_JWKS_URL=https://<issuer-host>/<jwks-path>
# SALES_MCP_FOUNDERS={"<founder-oauth-subject>":"RG","<another-subject>":null}
# SALES_MCP_DATABASE_URL=postgresql://<dedicated-login>.<project-id>:<password>@<session-pooler>:5432/postgres?sslmode=require
SALES_MCP_INCLUDE_PILOTS=false
SALES_MCP_STALE_AFTER_HOURS=84

# Sales Pipeline Updates (opt in only after migrations 012-014 and Sheet access are configured).
REVIEW_ENABLED=false
# Assign distinct random tokens to RG, NC, NDL. Never use INGEST_TOKEN here.
# REVIEW_TOKENS={"RG":"<at-least-32-random-characters>","NC":"<another-random-token>","NDL":"<another-random-token>"}
REVIEW_TOKENS={}
# Authorized source-of-truth spreadsheet and Pipeline tab. Share with the service-account email as Editor.
REVIEW_SPREADSHEET_ID=14lXRsWoEY63tOsz4SwggiItgTNPFWI4KDVTLay3MLDw
REVIEW_SHEET_TAB=Pipeline
REVIEW_SHEET_ID=1869050409
# Append new Client Context bullets without discarding existing context; replace is available deliberately.
REVIEW_CLIENT_CONTEXT_MODE=append
# One-line JSON service-account credential. Keep it in server environment secrets, never in HTML/Git.
# REVIEW_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
REVIEW_BUILD_BATCH=20
# First build snapshots the prior 14 days once. Daily gating uses the stored workspace timezone.
# Configure n8n's daily trigger after ingestion/processing; do not schedule force=true.
REVIEW_ALLOWED_ORIGINS=["https://claude.ai"]
